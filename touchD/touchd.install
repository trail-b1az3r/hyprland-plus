post_install() {
  # A built-in IPTS driver needs no out-of-tree DKMS copy.
  if grep -q '^CONFIG_HID_IPTS=y' "/boot/config-$(uname -r)" 2>/dev/null; then
    echo "touchD: IPTS is built into the running kernel; DKMS build skipped."
    return 0
  fi
  # Prefer the in-tree/linux-surface module when the running kernel already ships it.
  local module_path
  module_path="$(modinfo -k "$(uname -r)" -F filename ipts 2>/dev/null || true)"
  if [[ -n "$module_path" && "$module_path" == *"/kernel/"* ]]; then
    echo "touchD: using the kernel-provided IPTS module ($module_path); DKMS build skipped."
    return 0
  fi

  dkms add -m ipts -v 1.0.0 >/dev/null 2>&1 || true
  if [[ -d "/lib/modules/$(uname -r)/build" ]]; then
    dkms install -m ipts -v 1.0.0 -k "$(uname -r)" || {
      echo "touchD: IPTS DKMS build did not complete. Check kernel headers and linux-surface patches with: dkms status"
    }
  else
    echo "touchD: install matching kernel headers, then run: sudo dkms install -m ipts -v 1.0.0"
  fi
}

post_upgrade() {
  post_install
}

pre_remove() {
  dkms remove -m ipts -v 1.0.0 --all >/dev/null 2>&1 || true
}
